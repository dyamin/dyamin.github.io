---
layout: default
---
{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% if page.cv_download %}
    <div class="cta-row cv-download-row cv-download-top">
      <a
        class="cta-btn cta-btn-primary"
        href="{{ page.cv_download | relative_url }}"
        aria-label="Download Daniel Yamin's CV as a PDF"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i> Download CV (PDF)
      </a>
    </div>
  {% endif %}
  {% al_folio_cv_render %}
  {% if page.cv_download %}
    <div class="cta-row cv-download-row">
      <a
        class="cta-btn cta-btn-primary"
        href="{{ page.cv_download | relative_url }}"
        aria-label="Download Daniel Yamin's CV as a PDF"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i> Download CV (PDF)
      </a>
    </div>
  {% endif %}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin and set <code>al_folio.features.cv.enabled: true</code> to render this page.</p>
    </article>
  </div>
{% endif %}
